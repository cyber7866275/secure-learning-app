<?xml version="1.0" encoding="utf-8"?>
<!-- Production: cleartext is OFF (see manifest). Dev exception ONLY for the
     Android emulator loopback (10.0.2.2) so http://10.0.2.2:3000 works while
     developing. Point BASE_URL at https for any real deployment. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
