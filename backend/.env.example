# ---- Database ---------------------------------------------------------------
# Docker compose default: postgres://app:app@localhost:5432/securelearn
DATABASE_URL="postgresql://app:app@localhost:5432/securelearn?schema=public"

# ---- Redis ------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---- Server -----------------------------------------------------------------
PORT=3000
# Comma-separated origins or "*" for dev. Never "*" in production.
CORS_ORIGIN="*"

# ---- JWT --------------------------------------------------------------------
# REQUIRED. Minimum 32 chars. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_ME_GENERATE_WITH_openssl_rand_base64_48
# Access token lifetime (seconds). 900 = 15 minutes.
ACCESS_TOKEN_TTL_SEC=900
# Refresh token lifetime (days). Rotating; reuse = theft detection.
REFRESH_TOKEN_TTL_DAYS=30

# ---- OTP --------------------------------------------------------------------
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60

# ---- Device policy ----------------------------------------------------------
# Default device limit for newly created users.
DEFAULT_MAX_DEVICES=1
# What to do when a login would exceed max_devices:
#   revoke-oldest -> oldest device session is revoked (recommended)
#   deny          -> login is rejected with 403
DEVICE_OVERFLOW_BEHAVIOR="revoke-oldest"

# ---- Seed (owner admin) -----------------------------------------------------
# REQUIRED only when running `npm run seed`. Never commit real values.
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD_MIN_12_CHARS

# ---- Object storage (S3-compatible) ----------------------------------------
# Private bucket for PDFs/videos. The API only issues presigned URLs — the
# bucket itself must NEVER be public.
# Local dev (docker compose MinIO, create the bucket "securelearn" once via
# the console at http://localhost:9001, or: mc mb local/securelearn):
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="securelearn"
STORAGE_ACCESS_KEY=REPLACE_ME_WITH_R2_OR_MINIO_ACCESS_KEY
STORAGE_SECRET_KEY=REPLACE_ME_WITH_R2_OR_MINIO_SECRET_KEY
# "true" for MinIO / local S3 emulators, "false" for AWS S3 / Cloudflare R2.
STORAGE_FORCE_PATH_STYLE="true"

# ---- Signed URL lifetimes (seconds) ----------------------------------------
# How long an issued content URL stays valid. Short = safer.
PDF_ACCESS_TTL_SEC=300
VIDEO_ACCESS_TTL_SEC=600
# How long an admin has to upload a file after requesting a presigned PUT URL.
UPLOAD_TTL_SEC=900

# ---- Video processing / HLS (Stage 5) ---------------------------------------
# Secret for HLS stream tokens (HMAC). Generate: openssl rand -hex 32
HLS_TOKEN_SECRET=REPLACE_ME_GENERATE_WITH_openssl_rand_base64_48
# Lifetime of variant/segment/key presigned URLs AND the HLS token itself.
HLS_SEGMENT_TTL_SEC=600
# ffmpeg/ffprobe binaries used by the packaging worker.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Public base URL of this API — used to build absolute HLS manifest URLs.
API_PUBLIC_URL=http://localhost:3000
# In-process packaging worker: polls for PENDING videos on an interval.
VIDEO_WORKER_ENABLED=true
VIDEO_WORKER_INTERVAL_MS=30000

# ---- Play Integrity (Stage 7) ---------------------------------------------------
# Device/app integrity verification via Google Play. OFF by default: tokens only
# decode for Play-distributed apps, so dev/emulator builds would fail.
# Enforcement mode is controlled per admin panel: Settings -> integrity_enforcement
# (off | log | block). When enabled here but misconfigured, the service fails
# OPEN and logs loudly — never silently locks users out.
PLAY_INTEGRITY_ENABLED=false
ANDROID_PACKAGE_NAME=com.securelearn.app
# Service-account JSON with the Play Integrity API enabled in Google Cloud.
# The googleapis client reads this env var automatically. In production, mount
# it as a secret file, never commit it.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-play.json
